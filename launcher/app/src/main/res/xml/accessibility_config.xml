<?xml version="1.0" encoding="utf-8"?>
<!--
  Grants the launcher's accessibility service permission to filter key events (BACK, and HOME on
  the builds that route it through accessibility). We ask for the minimum required: no event
  types besides window-state-changed (used only to track the foreground package), no retrieval
  of window content, no touch exploration.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/accessibility_desc"
    android:notificationTimeout="100"
    android:summary="@string/accessibility_summary" />
